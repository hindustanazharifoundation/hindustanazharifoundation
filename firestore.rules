rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Gallery, projects and members: open (admin page uses a simple password) with data checks.
    // Suggestions: visitors can add them; they are not shown on the website, only in the admin page.
    match /suggestions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','contact','message','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow read, delete: if true;
    }
    match /gallery/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['data','caption','createdAt'])
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if true;
    }
    match /projects/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['title','date','desc','fileName','size','chunks','createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() < 120;
      allow delete: if true;
      match /chunks/{cid} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['i','d'])
          && request.resource.data.d is string && request.resource.data.d.size() < 900000;
        allow delete: if true;
      }
    }
    match /members/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name','type','role','order'])
        && request.resource.data.name is string && request.resource.data.name.size() < 80;
      allow delete: if true;
    }
  }
}
